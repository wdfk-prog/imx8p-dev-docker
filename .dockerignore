.git
.git/

# /workspace is runtime bind-mount content and must never become image context.
workspace/*
!workspace/.gitkeep

# Offline image packages can be tens of GiB. Keep them out of BuildKit context.
imx8p-dev-*-image.tar*
imx8p-dev-*-image.tgz*
imx8p-dev-*-image.tzst*
docker-images/

# prepare-assets.sh publishes only the final fixed-CMake asset under assets/.
assets/.cmake-*.tmp
assets/.cmake-*.tar.gz
